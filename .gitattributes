# Normalize text files unless overridden below.
* text=auto eol=lf

# Documentation and repository metadata.
*.md text eol=lf
*.markdown text eol=lf
*.rst text eol=lf
*.adoc text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.toml text eol=lf

CODEOWNERS text eol=lf
LICENSE text eol=lf
LICENSE.* text eol=lf
NOTICE text eol=lf
NOTICE.* text eol=lf

# Code samples and documentation tooling.
*.php text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.svg text eol=lf

# Shell and CLI files.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Git placeholders.
.gitkeep text eol=lf

# Binary image files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary

# Binary font files.
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Binary document and archive files.
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.tgz binary
*.7z binary
*.rar binary

# Binary media files.
*.mp3 binary
*.mp4 binary
*.mov binary
*.webm binary